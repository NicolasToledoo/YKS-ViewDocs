{
  "manifest_version": 3,
  "name": "YKS-ViewDocs",
  "version": "1.0.0",
  "description": "Visualize documentos PDF, DOC, DOCX, RTF, TXT, MD diretamente no navegador.",
  "permissions": [
    "contextMenus",
    "storage",
    "unlimitedStorage",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "YKS-ViewDocs",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["viewer/*", "lib/*", "styles/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
